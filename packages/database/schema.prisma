// LMN24 - Prisma schema
// Functional reference: docs/DATA_MODEL.md
// PostgreSQL uses snake_case; Prisma/TypeScript uses camelCase.
//
// Important:
// - CHECK constraints that cannot be expressed directly in Prisma remain enforced
//   through SQL migrations.
// - Setting uses partial unique indexes to support GLOBAL/CATEGORY/FEED scopes.
// - Prisma migrations must be managed only from packages/database.

generator client {
  provider               = "prisma-client"
  output                 = "./src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  previewFeatures        = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Country {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isoCode2  String   @unique(map: "country_iso_code2_unique") @map("iso_code2") @db.Char(2)
  isoCode3  String   @unique(map: "country_iso_code3_unique") @map("iso_code3") @db.Char(3)
  slug      String   @unique(map: "country_slug_unique") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sources Source[]

  @@map("country")
}

model Language {
  isoCode2  String   @id @map("iso_code2") @db.Char(2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  feeds      Feed[]
  articles   Article[]
  videoFeeds FeedVideo[]
  videos     Video[]
  horoscopes Horoscope[]

  @@map("language")
}

enum CategoryHomeLayout {
  FEATURED
  GRID
  LIST
  SPLIT
  MOSAIC
  COMPACT
  HEADLINES
  CAROUSEL

  @@map("category_home_layout")
}

model Category {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String             @unique(map: "category_slug_unique") @db.VarChar(255)
  isActive     Boolean            @default(true) @map("is_active")
  displayOrder Int                @unique(map: "category_display_order_unique") @map("display_order")
  layoutType   CategoryHomeLayout @default(GRID) @map("layout_type")
  themeColor   String             @default("#2563EB") @map("theme_color") @db.VarChar(7)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  feeds      Feed[]
  articles   Article[]
  videoFeeds FeedVideo[]
  videos     Video[]

  // Positive order and canonical #RRGGBB checks are enforced by SQL migrations.
  @@map("category")
}

model Source {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(255)
  slug       String   @unique(map: "source_slug_unique") @db.VarChar(255)
  websiteUrl   String   @map("website_url") @db.Text
  logoUrl      String?  @map("logo_url") @db.Text
  rssPageUrl   String?  @map("rss_page_url") @db.Text
  facebookUrl  String?  @map("facebook_url") @db.Text
  xUrl         String?  @map("x_url") @db.Text
  instagramUrl String?  @map("instagram_url") @db.Text
  youtubeUrl   String?  @map("youtube_url") @db.Text
  description  String?  @db.Text
  countryId  String   @map("country_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  country  Country   @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  feeds      Feed[]
  articles   Article[]
  videoFeeds FeedVideo[]
  videos     Video[]

  @@index([countryId], map: "idx_source_country_id")
  @@index([isActive], map: "idx_source_is_active")
  @@map("source")
}

model Feed {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId             String    @map("source_id") @db.Uuid
  categoryId           String    @map("category_id") @db.Uuid
  languageIsoCode2     String    @map("language_iso_code2") @db.Char(2)
  feedUrl              String    @unique(map: "feed_url_unique") @map("feed_url") @db.Text
  isActive             Boolean   @default(true) @map("is_active")
  lastFetchedAt        DateTime? @map("last_fetched_at") @db.Timestamptz(6)
  lastFetchDurationMs  Int?      @map("last_fetch_duration_ms")
  lastFetchStatus      String?   @map("last_fetch_status") @db.VarChar(32)
  lastError            String?   @map("last_error") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  language Language @relation(fields: [languageIsoCode2], references: [isoCode2], onDelete: Restrict, onUpdate: Cascade)
  runs     FeedRun[]

  @@index([sourceId], map: "idx_feed_source_id")
  @@index([categoryId], map: "idx_feed_category_id")
  @@index([languageIsoCode2], map: "idx_feed_language_iso_code2")
  @@index([isActive], map: "idx_feed_is_active")
  @@index([lastFetchedAt], map: "idx_feed_last_fetched_at")
  @@map("feed")
}

model Article {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId         String   @map("source_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  languageIsoCode2 String   @map("language_iso_code2") @db.Char(2)
  title            String   @db.Text
  summary          String?  @db.Text
  imageUrl         String?  @map("image_url") @db.Text
  articleUrl       String   @unique(map: "article_url_unique") @map("article_url") @db.Text
  publishedAt      DateTime @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  language Language @relation(fields: [languageIsoCode2], references: [isoCode2], onDelete: Restrict, onUpdate: Cascade)

  @@index([sourceId], map: "idx_article_source_id")
  @@index([categoryId], map: "idx_article_category_id")
  @@index([languageIsoCode2], map: "idx_article_language_iso_code2")
  @@index([publishedAt(sort: Desc)], map: "idx_article_published_at")
  @@index([sourceId, publishedAt(sort: Desc)], map: "idx_article_source_published_at")
  @@index([categoryId, publishedAt(sort: Desc)], map: "idx_article_category_published_at")
  @@index([languageIsoCode2, categoryId, publishedAt(sort: Desc)], map: "idx_article_language_category_published_at")
  @@map("article")
}


model ParserBatchRun {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parserType      String           @map("parser_type") @db.VarChar(16)
  trigger         String           @default("MANUAL") @db.VarChar(16)
  filters         Json             @default("{}")
  startedAt       DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?        @map("finished_at") @db.Timestamptz(6)
  status          String           @default("RUNNING") @db.VarChar(16)
  totalFeeds      Int              @default(0) @map("total_feeds")
  processedFeeds  Int              @default(0) @map("processed_feeds")
  successfulFeeds Int              @default(0) @map("successful_feeds")
  failedFeeds     Int              @default(0) @map("failed_feeds")
  itemsFound      Int              @default(0) @map("items_found")
  itemsImported   Int              @default(0) @map("items_imported")
  itemsSkipped    Int              @default(0) @map("items_skipped")
  lastHeartbeatAt DateTime         @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  events          ParserRunEvent[]
  infoRuns        FeedRun[]
  videoRuns       FeedVideoRun[]

  @@index([parserType, startedAt(sort: Desc)], map: "idx_parser_batch_type_started")
  @@index([status, lastHeartbeatAt], map: "idx_parser_batch_status_heartbeat")
  @@map("parser_batch_run")
}

model ParserRunEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchRunId  String         @map("batch_run_id") @db.Uuid
  timestamp   DateTime       @default(now()) @db.Timestamptz(6)
  level       String         @db.VarChar(8)
  eventType   String         @map("event_type") @db.VarChar(40)
  message     String         @db.VarChar(1024)
  feedId      String?        @map("feed_id") @db.Uuid
  feedVideoId String?        @map("feed_video_id") @db.Uuid
  batch       ParserBatchRun @relation(fields: [batchRunId], references: [id], onDelete: Cascade)

  @@index([batchRunId, timestamp, id], map: "idx_parser_run_event_batch_time")
  @@map("parser_run_event")
}

model FeedRun {
  batchRunId       String?   @map("batch_run_id") @db.Uuid
  batch            ParserBatchRun? @relation(fields: [batchRunId], references: [id], onDelete: SetNull)
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedId           String    @map("feed_id") @db.Uuid
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs       Int?      @map("duration_ms")
  status           String    @db.VarChar(32)
  itemsFound       Int       @default(0) @map("items_found")
  articlesImported Int       @default(0) @map("articles_imported")
  articlesSkipped  Int       @default(0) @map("articles_skipped")
  errorMessage     String?   @map("error_message") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([batchRunId], map: "idx_feed_run_batch_id")
  @@index([feedId], map: "idx_feed_run_feed_id")
  @@index([startedAt(sort: Desc)], map: "idx_feed_run_started_at")
  @@index([status], map: "idx_feed_run_status")
  @@index([feedId, startedAt(sort: Desc)], map: "idx_feed_run_feed_started_at")
  @@map("feed_run")
}

model Setting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @db.VarChar(255)
  value       String   @db.Text
  type        String   @db.VarChar(32)
  scope       String   @db.VarChar(32)
  scopeId     String?  @map("scope_id") @db.Uuid
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // PostgreSQL partial unique indexes used by the current schema:
  // - GLOBAL: key must be unique.
  // - CATEGORY / FEED: (key, scope, scope_id) must be unique.
  //
  @@unique([key], map: "uq_setting_global_key", where: raw("scope = 'GLOBAL'"))
  @@unique([key, scope, scopeId], map: "uq_setting_scoped_key", where: raw("scope IN ('CATEGORY', 'FEED')"))
  @@index([scope], map: "idx_setting_scope")
  @@index([scopeId], map: "idx_setting_scope_id")
  @@map("setting")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.Text
  firstName    String?   @map("first_name") @db.VarChar(255)
  lastName     String?   @map("last_name") @db.VarChar(255)
  role         String    @default("EDITOR") @db.VarChar(32)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  horoscopeImportRuns HoroscopeImportRun[]

  // The existing PostgreSQL schema enforces case-insensitive email uniqueness
  // with UNIQUE INDEX uq_app_user_email_lower ON app_user(LOWER(email)).
  // Expression indexes are maintained through SQL migrations.
  @@map("app_user")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "session_token_hash_unique") @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "idx_session_user_id")
  @@index([expiresAt], map: "idx_session_expires_at")
  @@index([revokedAt], map: "idx_session_revoked_at")
  @@map("session")
}


enum VideoPlatform {
  YOUTUBE

  @@map("video_platform")
}

model FeedVideo {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId            String        @map("source_id") @db.Uuid
  categoryId          String        @map("category_id") @db.Uuid
  languageIsoCode2    String        @map("language_iso_code2") @db.Char(2)
  platform            VideoPlatform @default(YOUTUBE)
  channelId           String        @map("channel_id") @db.VarChar(255)
  feedUrl             String        @unique(map: "feed_video_feed_url_unique") @map("feed_url") @db.Text
  isActive            Boolean       @default(true) @map("is_active")
  lastFetchedAt       DateTime?     @map("last_fetched_at") @db.Timestamptz(6)
  lastFetchDurationMs Int?          @map("last_fetch_duration_ms")
  lastFetchStatus     String?       @map("last_fetch_status") @db.VarChar(32)
  lastError           String?       @map("last_error") @db.Text
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source   Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  language Language       @relation(fields: [languageIsoCode2], references: [isoCode2], onDelete: Restrict, onUpdate: Cascade)
  videos   Video[]
  runs     FeedVideoRun[]

  @@unique([platform, channelId], map: "feed_video_platform_channel_unique")
  @@index([sourceId], map: "idx_feed_video_source_id")
  @@index([categoryId], map: "idx_feed_video_category_id")
  @@index([languageIsoCode2], map: "idx_feed_video_language_iso_code2")
  @@index([isActive], map: "idx_feed_video_is_active")
  @@index([lastFetchedAt], map: "idx_feed_video_last_fetched_at")
  @@map("feed_video")
}

model Video {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId            String        @map("source_id") @db.Uuid
  feedVideoId         String?       @map("feed_video_id") @db.Uuid
  categoryId          String        @map("category_id") @db.Uuid
  languageIsoCode2    String        @map("language_iso_code2") @db.Char(2)
  platform            VideoPlatform @default(YOUTUBE)
  platformVideoId     String        @map("platform_video_id") @db.VarChar(255)
  title               String        @db.Text
  description         String?       @db.Text
  thumbnailUrl        String?       @map("thumbnail_url") @db.Text
  videoUrl            String        @map("video_url") @db.Text
  publishedAt         DateTime      @map("published_at") @db.Timestamptz(6)
  updatedOnPlatformAt DateTime?     @map("updated_on_platform_at") @db.Timestamptz(6)
  isPublished         Boolean       @default(true) @map("is_published")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source    Source     @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  feedVideo FeedVideo? @relation(fields: [feedVideoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  language  Language   @relation(fields: [languageIsoCode2], references: [isoCode2], onDelete: Restrict, onUpdate: Cascade)

  @@unique([platform, platformVideoId], map: "video_platform_id_unique")
  @@index([sourceId], map: "idx_video_source_id")
  @@index([feedVideoId], map: "idx_video_feed_video_id")
  @@index([categoryId], map: "idx_video_category_id")
  @@index([languageIsoCode2], map: "idx_video_language_iso_code2")
  @@index([publishedAt(sort: Desc)], map: "idx_video_published_at")
  @@index([isPublished], map: "idx_video_is_published")
  @@index([languageIsoCode2, categoryId, publishedAt(sort: Desc)], map: "idx_video_language_category_published")
  @@map("video")
}

model FeedVideoRun {
  batchRunId     String?   @map("batch_run_id") @db.Uuid
  batch          ParserBatchRun? @relation(fields: [batchRunId], references: [id], onDelete: SetNull)
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedVideoId    String    @map("feed_video_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs     Int?      @map("duration_ms")
  status         String    @db.VarChar(32)
  itemsFound     Int       @default(0) @map("items_found")
  videosImported Int       @default(0) @map("videos_imported")
  videosSkipped  Int       @default(0) @map("videos_skipped")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  feedVideo FeedVideo @relation(fields: [feedVideoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([batchRunId], map: "idx_feed_video_run_batch_id")
  @@index([feedVideoId], map: "idx_feed_video_run_feed_video_id")
  @@index([startedAt(sort: Desc)], map: "idx_feed_video_run_started_at")
  @@index([status], map: "idx_feed_video_run_status")
  @@index([feedVideoId, startedAt(sort: Desc)], map: "idx_feed_video_run_feed_started_at")
  @@map("feed_video_run")
}

// -----------------------------------------------------------------------------
// SCRUM-48 — Hashtags (MVP)
// No ArticleHashtag table: an article is counted at most once per hashtag.
// Normalized alias keys are produced by the application and checked by the DB.
// -----------------------------------------------------------------------------

model Hashtag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique(map: "hashtag_slug_unique") @db.VarChar(255)
  imageUrl  String?  @map("image_url") @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  aliases      HashtagAlias[]
  hourlyCounts HashtagHourlyCount[]

  @@index([isActive], map: "idx_hashtag_is_active")
  @@map("hashtag")
}

model HashtagAlias {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hashtagId        String   @map("hashtag_id") @db.Uuid
  name             String   @db.VarChar(255)
  // NFKC + Unicode case folding + Latin accent removal + space normalization.
  // The backend/parser must share one canonicalization function for this value.
  normalizedName   String   @map("normalized_name") @db.VarChar(255)
  // Optional descriptive ISO code; no FK to Language: aliases may use languages
  // not enabled for publishing LMN24 articles.
  languageIsoCode2 String?  @map("language_iso_code2") @db.Char(2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "hashtag_alias_hashtag_id_fkey")

  @@unique([hashtagId, normalizedName], map: "hashtag_alias_hashtag_normalized_unique")
  @@map("hashtag_alias")
}

model HashtagHourlyCount {
  hashtagId   String   @map("hashtag_id") @db.Uuid
  hourUtc     DateTime @map("hour_utc") @db.Timestamptz(6)
  articleCount Int     @default(0) @map("article_count")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "hashtag_hourly_count_hashtag_id_fkey")

  @@id([hashtagId, hourUtc], map: "hashtag_hourly_count_pkey")
  @@index([hourUtc], map: "idx_hashtag_hourly_count_hour_utc")
  @@map("hashtag_hourly_count")
}


// SCRUM-62 — Horoscope: date is a civil calendar day (Europe/Paris).
model HoroscopeAstronomySnapshot {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date              DateTime   @unique(map: "horoscope_astronomy_date_unique") @db.Date
  generatedAt       DateTime   @map("generated_at") @db.Timestamptz(6)
  timezone          String     @db.VarChar(64)
  astronomy         Json
  sourceFile        String     @map("source_file") @db.VarChar(255)
  sourceFingerprint String     @map("source_fingerprint") @db.VarChar(64)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  horoscopes        Horoscope[]

  @@map("horoscope_astronomy_snapshot")
}

model Horoscope {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                DateTime  @db.Date
  sign                String    @db.VarChar(20)
  languageIsoCode2    String    @map("language_iso_code2") @db.Char(2)
  general             String    @db.Text
  love                String    @db.Text
  work                String    @db.Text
  finance             String    @db.Text
  disclaimer          String    @db.Text
  sourceFile          String    @map("source_file") @db.VarChar(255)
  sourceFingerprint   String    @map("source_fingerprint") @db.VarChar(64)
  astronomySnapshotId String    @map("astronomy_snapshot_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  language          Language                   @relation(fields: [languageIsoCode2], references: [isoCode2], onDelete: Restrict, onUpdate: Cascade)
  astronomySnapshot HoroscopeAstronomySnapshot @relation(fields: [astronomySnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([date, sign, languageIsoCode2], map: "horoscope_date_sign_language_unique")
  @@index([languageIsoCode2, sign, date], map: "idx_horoscope_language_sign_date")
  @@index([astronomySnapshotId], map: "idx_horoscope_astronomy_snapshot_id")
  @@map("horoscope")
}

model HoroscopeImportRun {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType        String    @map("source_type") @db.VarChar(16)
  sourceFile        String    @map("source_file") @db.VarChar(255)
  fileFingerprint   String?   @map("file_fingerprint") @db.VarChar(64)
  targetDate        DateTime? @map("target_date") @db.Date
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)
  status            String    @default("RUNNING") @db.VarChar(16)
  itemsExpected     Int       @default(96) @map("items_expected")
  itemsValid        Int       @default(0) @map("items_valid")
  itemsInserted     Int       @default(0) @map("items_inserted")
  itemsSkipped      Int       @default(0) @map("items_skipped")
  itemsErrored      Int       @default(0) @map("items_errored")
  errorMessage      String?   @map("error_message") @db.Text
  triggeredByUserId String?   @map("triggered_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  triggeredByUser User? @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([startedAt(sort: Desc)], map: "idx_horoscope_import_run_started_at")
  @@index([targetDate, startedAt(sort: Desc)], map: "idx_horoscope_import_run_date_started")
  @@index([status], map: "idx_horoscope_import_run_status")
  @@index([triggeredByUserId], map: "idx_horoscope_import_run_user")
  @@map("horoscope_import_run")
}


// SCRUM-69 — Weather worldwide: 66 seeded cities and last current observation.
// The current weather record is a cache, not a permanent observation history.
// PostgreSQL CHECK constraints are enforced by database/migrations/011.
model WeatherCity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @unique(map: "weather_city_slug_key") @db.VarChar(120)
  name          String   @db.VarChar(120)
  countryIso2   String   @map("country_iso2") @db.Char(2)
  continentCode String   @map("continent_code") @db.Char(2)
  latitude      Decimal  @db.Decimal(9, 6)
  longitude     Decimal  @db.Decimal(9, 6)
  timezone      String   @db.VarChar(64)
  displayOrder  Int      @map("display_order") @db.SmallInt
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  current WeatherCurrent?

  @@unique([continentCode, displayOrder], map: "weather_city_continent_order_uq")
  @@index([countryIso2], map: "idx_weather_city_country_iso2")
  @@index([continentCode, displayOrder], map: "idx_weather_city_active_continent_order", where: raw("is_active = true"))
  @@map("weather_city")
}

model WeatherCurrent {
  cityId               String   @id @map("city_id") @db.Uuid
  temperatureC         Decimal  @map("temperature_c") @db.Decimal(5, 2)
  apparentTemperatureC Decimal? @map("apparent_temperature_c") @db.Decimal(5, 2)
  humidityPct          Int?     @map("humidity_pct") @db.SmallInt
  windSpeedKmh         Decimal? @map("wind_speed_kmh") @db.Decimal(6, 2)
  weatherCode          Int      @map("weather_code") @db.SmallInt
  isDay                Boolean  @map("is_day")
  observedAt           DateTime @map("observed_at") @db.Timestamptz(6)
  fetchedAt            DateTime @map("fetched_at") @db.Timestamptz(6)
  provider             String   @default("OPEN_METEO") @db.VarChar(32)

  city WeatherCity @relation(fields: [cityId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "weather_current_city_id_fkey")

  @@index([observedAt], map: "idx_weather_current_observed_at")
  @@map("weather_current")
}

model WeatherRun {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trigger          String    @default("MANUAL") @db.VarChar(16)
  continentCode    String?   @map("continent_code") @db.Char(2)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  status           String    @default("RUNNING") @db.VarChar(16)
  totalCities      Int       @default(0) @map("total_cities")
  processedCities  Int       @default(0) @map("processed_cities")
  successfulCities Int       @default(0) @map("successful_cities")
  failedCities     Int       @default(0) @map("failed_cities")
  errorMessage     String?   @map("error_message") @db.Text

  @@index([startedAt(sort: Desc)], map: "idx_weather_run_started_at")
  @@index([status], map: "idx_weather_run_status")
  @@map("weather_run")
}


// SCRUM-83/84 — Durable scheduler configuration and coalesced work queue.
// Scheduling is opt-in: no process may run from these rows until enabled by an administrator.
model SchedulerConfig {
  parserType        String    @id @map("parser_type") @db.VarChar(24)
  isEnabled         Boolean   @default(false) @map("is_enabled")
  intervalMinutes   Int?      @map("interval_minutes")
  localTime         String?   @map("local_time") @db.VarChar(5)
  timezone          String    @default("Europe/Paris") @db.VarChar(64)
  nextDueAt         DateTime? @map("next_due_at") @db.Timestamptz(6)
  lastScheduledAt    DateTime? @map("last_scheduled_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobs SchedulerJob[]

  @@map("scheduler_config")
}

model SchedulerJob {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parserType      String    @map("parser_type") @db.VarChar(24)
  scheduledFor    DateTime  @map("scheduled_for") @db.Timestamptz(6)
  status          String    @default("PENDING") @db.VarChar(16)
  attempt         Int       @default(0)
  notBefore       DateTime  @default(now()) @map("not_before") @db.Timestamptz(6)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  lastError       String?   @map("last_error") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  config SchedulerConfig @relation(fields: [parserType], references: [parserType], onDelete: Restrict)

  @@index([status, notBefore, scheduledFor], map: "idx_scheduler_job_dispatch")
  @@index([parserType, scheduledFor(sort: Desc)], map: "idx_scheduler_job_parser_date")
  @@map("scheduler_job")
}
