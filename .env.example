# Shared local defaults
NODE_ENV=development

# Service ports
FRONTEND_PORT=3000
BACKEND_PORT=3001
PARSER_PORT=3002

# PostgreSQL
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/lmn24"

# Internal service URLs
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"
PARSER_INTERNAL_URL="http://localhost:3002"

# Secrets - replace locally, never commit real values
SESSION_SECRET="CHANGE_ME"
SESSION_COOKIE_NAME="lmn24_session"
SESSION_TTL_HOURS="8"
PARSER_SHARED_SECRET="CHANGE_ME"

# CORS
CORS_ORIGINS="http://localhost:3000"

# Public origin accepted for weather administration mutations behind a reverse proxy.
# Configure on the VPS to the exact HTTPS origin (no trailing path): https://www.lmn24.com
# Empty locally: same-origin protection uses the incoming request URL.
WEATHER_ADMIN_PUBLIC_ORIGIN=""

# SMTP - optional until email features are implemented
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Source media / website capture
# Optional. Defaults to apps/backend/uploads/sources when the backend is started from its workspace.
SOURCE_MEDIA_DIR=""
# Hashtag images: set to a durable/writable, backed-up directory (e.g. D:\\LMN24\\uploads\\hashtags).\n# Default when empty: apps/backend/uploads/hashtags (local development only).\nHASHTAG_MEDIA_DIR=""\n# Optional path to a Chromium/Chrome executable used for website captures.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""

# YouTube channel ID resolution (optional; server-side only)
# Configure a Google Cloud API key with YouTube Data API v3 enabled.
# Never put this key in a NEXT_PUBLIC_* variable or commit a real value.
YOUTUBE_API_KEY=""

# Worldwide weather visitor continent (SCRUM-75)
# Default is empty: all non-preference visits show Europe (EU).
# Set to "cloudflare" ONLY if the public origin is restricted to Cloudflare
# and client-supplied CF-IPContinent headers cannot bypass that trusted proxy.
# No external GeoIP API key is required; no IP is stored.
WEATHER_GEOIP_PROVIDER=""
