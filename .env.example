# Shared local defaults
NODE_ENV=development

# Service ports
FRONTEND_PORT=3000
BACKEND_PORT=3001
PARSER_PORT=3002

# PostgreSQL
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/lmn24"

# Internal service URLs
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"
PARSER_INTERNAL_URL="http://localhost:3002"

# Secrets - replace locally, never commit real values
SESSION_SECRET="CHANGE_ME"
PARSER_SHARED_SECRET="CHANGE_ME"

# CORS
CORS_ORIGINS="http://localhost:3000"

# SMTP - optional until email features are implemented
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
