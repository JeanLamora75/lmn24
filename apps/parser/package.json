  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@lmn24/eslint-config": "workspace:*"
